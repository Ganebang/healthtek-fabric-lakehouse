table _Mesures
	lineageTag: a1000001-0000-4000-8000-000000000001

	measure 'Shortage Events' = COUNTROWS ( gold_fact_shortage )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: a1000002-0000-4000-8000-000000000001

	measure 'Active Shortages' = CALCULATE ( [Shortage Events], gold_fact_shortage[is_active] = TRUE () )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 8d7ad870-e151-5fcb-93e0-a85df7c34de1

	measure 'Drugs Affected' = DISTINCTCOUNT ( gold_fact_shortage[cis_code] )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 13b749eb-c7c8-5c13-851f-77b8e8d468a3

	measure 'Active Drugs Affected' = CALCULATE ( [Drugs Affected], gold_fact_shortage[is_active] = TRUE () )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 2118a5b5-f899-5aa0-8b19-4c5875b89008

	measure 'Marketed Drugs' = CALCULATE ( COUNTROWS ( gold_dim_drug ), gold_dim_drug[is_commercialisee] = TRUE (), gold_dim_drug[is_inferred] = FALSE (), gold_dim_drug[drug_sk] <> -1 )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 0e2a9ce5-3e99-5f98-9a00-8a05752409bc

	measure 'Shortage Rate %' = DIVIDE ( [Active Drugs Affected], [Marketed Drugs], BLANK () )
		formatString: 0.0%
		displayFolder: 01 - Suivi des ruptures
		lineageTag: b8134b84-9565-5934-8a4d-8ebbb33ffe41

	measure 'Avg Duration (days)' = CALCULATE ( AVERAGE ( gold_fact_shortage[duration_days] ), KEEPFILTERS ( gold_fact_shortage[duration_days] >= 0 ) )
		formatString: #,0.0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: d19fdec5-05f4-5482-964c-cb55c6fa9e3d

	measure 'Median Duration (days)' = CALCULATE ( MEDIAN ( gold_fact_shortage[duration_days] ), KEEPFILTERS ( gold_fact_shortage[duration_days] >= 0 ) )
		formatString: #,0.0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 826f5c74-5f80-5029-ad29-5f3f16a4abf0

	measure 'P90 Duration (days)' = CALCULATE ( PERCENTILE.INC ( gold_fact_shortage[duration_days], 0.9 ), KEEPFILTERS ( gold_fact_shortage[duration_days] >= 0 ) )
		formatString: #,0.0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: ba26ccb9-53c6-50e9-9fc6-7b373ddd1a1e

	measure 'Long Shortages (>365 d)' = CALCULATE ( [Shortage Events], gold_fact_shortage[duration_bucket] = "> 365 jours" )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: c303f830-2164-5ccb-a09b-c9266a400971

	measure 'Stale Shortage Records' = CALCULATE ( [Shortage Events], gold_fact_shortage[days_since_update] > 90 )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 75f6bd61-56bb-531f-b545-b4ae157fbabf

	measure 'Overdue Return Dates' = CALCULATE ( [Shortage Events], gold_fact_shortage[remise_depassee] = TRUE () )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: afdbae7f-b5ff-549b-bbfe-664a125ff6b4

	measure 'MITM Active Drugs Affected' = CALCULATE ( [Active Drugs Affected], gold_dim_drug[is_mitm] = TRUE () )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: aa4e51be-0a0c-5045-8e56-77483aae7fe7

	measure 'Shortages Ended (end date)' = CALCULATE ( [Shortage Events], USERELATIONSHIP ( gold_fact_shortage[time_end_sk], gold_dim_time[time_sk] ) )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 143ca030-36bb-5f5b-8821-2bd0753d1949

	measure 'Risk Drugs' = COUNTROWS ( gold_kpi_shortage_risk_score )
		formatString: #,0
		displayFolder: 02 - Score de risque
		lineageTag: 15544067-0861-549a-bcc1-f7b24bbc14d0

	measure 'Critical Drugs' = CALCULATE ( [Risk Drugs], gold_kpi_shortage_risk_score[risk_category] = "Critique" )
		formatString: #,0
		displayFolder: 02 - Score de risque
		lineageTag: ec2b1a72-116d-5846-b208-abeabd42948e

	measure 'High Drugs' = CALCULATE ( [Risk Drugs], gold_kpi_shortage_risk_score[risk_category] = "Élevé" )
		formatString: #,0
		displayFolder: 02 - Score de risque
		lineageTag: cacf5e1f-2a19-5802-b870-bd6c5d664178

	measure 'Avg Risk Score' = AVERAGE ( gold_kpi_shortage_risk_score[risk_score] )
		formatString: #,0.0
		displayFolder: 02 - Score de risque
		lineageTag: 7d43481b-2278-5fd4-a42c-d2d5d509de61

	measure 'Max Risk Score' = MAX ( gold_kpi_shortage_risk_score[risk_score] )
		formatString: #,0.0
		displayFolder: 02 - Score de risque
		lineageTag: f59d0883-0453-56e8-95cd-6df2de5cfa39

	measure 'No Alternative Active Drugs' = CALCULATE ( [Risk Drugs], gold_kpi_shortage_risk_score[no_alternative] = TRUE (), gold_kpi_shortage_risk_score[active_shortages] > 0 )
		formatString: #,0
		displayFolder: 02 - Score de risque
		lineageTag: 795f10dc-5bd3-59fd-9766-2e3830b1cd6e

	measure 'No Alternative %' = DIVIDE ( [No Alternative Active Drugs], CALCULATE ( [Risk Drugs], gold_kpi_shortage_risk_score[active_shortages] > 0 ), BLANK () )
		formatString: 0.0%
		displayFolder: 02 - Score de risque
		lineageTag: 4e6e4801-3e84-509f-86ff-764466919cca

	measure 'Latest Snapshot' = MAX ( gold_fact_presentation_price[snapshot_date] )
		formatString: yyyy-mm-dd
		displayFolder: 03 - Prix et remboursement
		lineageTag: 8aecaddd-2d2e-5f7c-bb0c-a9d6880c2093

	measure 'Priced Boxes (latest)' = VAR d = [Latest Snapshot] RETURN CALCULATE ( COUNTROWS ( gold_fact_presentation_price ), gold_fact_presentation_price[snapshot_date] = d, gold_fact_presentation_price[has_price] = TRUE () )
		formatString: #,0
		displayFolder: 03 - Prix et remboursement
		lineageTag: 73d4f99e-4857-52f0-bb68-765fb2cc2354

	measure 'Boxes (latest)' = VAR d = [Latest Snapshot] RETURN CALCULATE ( COUNTROWS ( gold_fact_presentation_price ), gold_fact_presentation_price[snapshot_date] = d )
		formatString: #,0
		displayFolder: 03 - Prix et remboursement
		lineageTag: cf942d53-fd9c-5353-b656-6a689723b8ff

	measure 'Reimbursed Boxes (latest)' = VAR d = [Latest Snapshot] RETURN CALCULATE ( COUNTROWS ( gold_fact_presentation_price ), gold_fact_presentation_price[snapshot_date] = d, gold_fact_presentation_price[is_reimbursed] = TRUE () )
		formatString: #,0
		displayFolder: 03 - Prix et remboursement
		lineageTag: c572bd99-a103-5987-b6c4-52a77215ae36

	measure 'Reimbursed Share %' = DIVIDE ( [Reimbursed Boxes (latest)], [Boxes (latest)], BLANK () )
		formatString: 0.0%
		displayFolder: 03 - Prix et remboursement
		lineageTag: 1c2963d5-df70-50a0-b692-5292faf1271c

	measure 'Avg Price (EUR)' = VAR d = [Latest Snapshot] RETURN CALCULATE ( AVERAGE ( gold_fact_presentation_price[prix_hors_honoraires] ), gold_fact_presentation_price[snapshot_date] = d, gold_fact_presentation_price[has_price] = TRUE () )
		formatString: #,0.00 "€"
		displayFolder: 03 - Prix et remboursement
		lineageTag: 93f7caa1-92e9-599c-a1d7-96a22680c46e

	measure 'Avg Price Incl. Fees (EUR)' = VAR d = [Latest Snapshot] RETURN CALCULATE ( AVERAGE ( gold_fact_presentation_price[prix_avec_honoraires] ), gold_fact_presentation_price[snapshot_date] = d, gold_fact_presentation_price[has_price] = TRUE () )
		formatString: #,0.00 "€"
		displayFolder: 03 - Prix et remboursement
		lineageTag: db6dc50c-6f30-5593-a6bf-84ec5cabbf82

	measure 'Price Drops' = CALCULATE ( COUNTROWS ( gold_kpi_price_movement ), gold_kpi_price_movement[movement] = "Baisse" )
		formatString: #,0
		displayFolder: 03 - Prix et remboursement
		lineageTag: 11db32cd-5940-5ad7-bfd7-1218a6df00f3

	measure 'Price Rises' = CALCULATE ( COUNTROWS ( gold_kpi_price_movement ), gold_kpi_price_movement[movement] = "Hausse" )
		formatString: #,0
		displayFolder: 03 - Prix et remboursement
		lineageTag: 1fbad332-053d-5a83-b199-a087597597be

	measure 'Comparable Prices' = [Price Drops] + [Price Rises] + CALCULATE ( COUNTROWS ( gold_kpi_price_movement ), gold_kpi_price_movement[movement] = "Stable" )
		formatString: #,0
		displayFolder: 03 - Prix et remboursement
		lineageTag: 28fd7e53-39b3-59cb-a560-9614b45a6e9a

	measure 'Price Drops %' = DIVIDE ( [Price Drops], [Comparable Prices], BLANK () )
		formatString: 0.0%
		displayFolder: 03 - Prix et remboursement
		lineageTag: 033ccc33-7767-5c83-b532-f6e67801ae4f

	measure 'Price Rises %' = DIVIDE ( [Price Rises], [Comparable Prices], BLANK () )
		formatString: 0.0%
		displayFolder: 03 - Prix et remboursement
		lineageTag: ebee0317-25a9-57e9-82ed-78684e9fe938

	measure 'Groups Compared' = COUNT ( gold_kpi_generic_price_gap[gap_pct] )
		formatString: #,0
		displayFolder: 04 - Génériques
		lineageTag: cdcb6ae3-7977-59d6-8a6a-dcd0d9aa352f

	measure 'Avg Princeps Price (EUR)' = AVERAGE ( gold_kpi_generic_price_gap[avg_princeps_price] )

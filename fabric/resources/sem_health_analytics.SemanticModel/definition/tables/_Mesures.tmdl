		displayFolder: 04 - Génériques
		lineageTag: 567501b0-f713-52eb-9709-63725f693fbe

	measure 'Avg Generic Gap %' = VAR _Princeps = [Avg Princeps Price (EUR)] VAR _Generic  = [Avg Generic Price (EUR)] RETURN IF ( ISBLANK ( _Princeps ) || ISBLANK ( _Generic ), BLANK (), DIVIDE ( _Princeps - _Generic, _Princeps, BLANK () ) )
		formatString: 0.0%
		displayFolder: 04 - Génériques
		lineageTag: 57d0b976-7e32-566e-884e-7a282237982b

	measure 'Generic Drugs' = CALCULATE ( COUNTROWS ( gold_dim_drug ), gold_dim_drug[is_generic] = TRUE (), gold_dim_drug[is_inferred] = FALSE () )
		formatString: #,0
		displayFolder: 04 - Génériques
		lineageTag: afcebd63-2e5b-5947-9637-5a2d6079d28b

	measure 'Princeps Drugs' = CALCULATE ( COUNTROWS ( gold_dim_drug ), gold_dim_drug[is_princeps] = TRUE (), gold_dim_drug[is_inferred] = FALSE () )
		formatString: #,0
		displayFolder: 04 - Génériques
		lineageTag: a107182f-a74f-52ba-a50e-28d89aa76a76

	measure 'SMR Drugs (latest)' = CALCULATE ( DISTINCTCOUNT ( gold_fact_has_opinion[cis_code] ), gold_fact_has_opinion[opinion_type] = "SMR", gold_fact_has_opinion[is_latest_avis] = TRUE () )

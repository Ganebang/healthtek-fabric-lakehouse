	/// Durée moyenne (jours) des signalements encore actifs (rupture ou tension).
	measure 'Active Avg Duration (days)' = CALCULATE ( [Avg Duration (days)], gold_fact_shortage[is_active] = TRUE () )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 0f4263a1-df5f-47f6-a1e1-9306dc8c9b9b

	/// Durée médiane (jours) des signalements actifs, robuste aux valeurs extrêmes.
	measure 'Active Median Duration (days)' = CALCULATE ( [Median Duration (days)], gold_fact_shortage[is_active] = TRUE () )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: de43b128-8502-4962-99e3-3856876d0abd

	/// Libellé de carte KPI : durée moyenne active suffixée de « j ».
	measure 'Active Avg Duration Label' = VAR _d = [Active Avg Duration (days)] RETURN IF ( ISBLANK ( _d ), "–", FORMAT ( _d, "#,0" ) & " j" )
		displayFolder: 01 - Suivi des ruptures
		lineageTag: a03bc48b-cd97-4b25-b14a-29a150371b0b

	/// Durée maximale (jours) parmi les signalements actifs ; sert au Top 10 des ruptures les plus longues.
	measure 'Max Active Duration (days)' = CALCULATE ( MAX ( gold_fact_shortage[duration_days] ), gold_fact_shortage[is_active] = TRUE () )
		formatString: #,0 "j"
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 85999203-765c-42ea-be43-5587d5635b08

	/// Signalements débutés sur la période (relation active date_debut → calendrier).
	measure 'Shortages Started' = [Shortage Events]
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 2a90915b-dd2d-4e4c-8a7c-dd74407b6825

	/// Sous-titre dynamique de la carte durée.
	measure 'Duration Caption' = "Durée moyenne (médiane " & FORMAT ( [Active Median Duration (days)], "#,0" ) & " j)"
		displayFolder: 09 - Libellés & navigation
		lineageTag: 569628ef-b3f8-497c-b42b-735f806d8c21

	/// Pied de page : date de l'instantané BDPM affiché.
	measure 'Snapshot Caption' = VAR _d = MAX ( gold_fact_shortage[as_of_date] ) RETURN "Données réelles BDPM · ANSM — instantané du " & FORMAT ( _d, "dd/mm/yyyy" )
		displayFolder: 09 - Libellés & navigation
		lineageTag: 7ddfc6b8-e02b-475d-bf84-296e37d3046d

	measure 'Report Title Ruptures' = "Suivi des ruptures et tensions d'approvisionnement"
		displayFolder: 09 - Libellés & navigation
		lineageTag: 9916a2dc-9ae6-4ee4-90a8-8282cd9daacf

	/// Nombre de contrôles qualité effectivement évalués.
	measure 'DQ Checks Run' = CALCULATE ( COUNTROWS ( '_dq_audit_log' ), '_dq_audit_log'[skipped] = FALSE () )
		formatString: #,0
		displayFolder: 08 - Qualité des données
		lineageTag: b0923179-b7d4-4c93-a8af-83de11d69bed

	measure 'DQ Checks Passed' = CALCULATE ( COUNTROWS ( '_dq_audit_log' ), '_dq_audit_log'[skipped] = FALSE (), '_dq_audit_log'[passed] = TRUE () )
		formatString: #,0
		displayFolder: 08 - Qualité des données
		lineageTag: 5175379c-8e62-4069-a6ae-c1e820d599fd

	/// Taux de contrôles qualité réussis.
	measure 'DQ Pass Rate %' = DIVIDE ( [DQ Checks Passed], [DQ Checks Run], BLANK () )
		formatString: 0.0%
		displayFolder: 08 - Qualité des données
		lineageTag: 8626ced4-ba64-4af4-b554-84debf6629ce

	/// Contrôles critiques en échec (bloquent la porte qualité si fail_fast).
	measure 'DQ Critical Failures' = CALCULATE ( COUNTROWS ( '_dq_audit_log' ), '_dq_audit_log'[skipped] = FALSE (), '_dq_audit_log'[passed] = FALSE (), '_dq_audit_log'[severity] = "critical" )
		formatString: #,0
		displayFolder: 08 - Qualité des données
		lineageTag: a726d376-5001-4c43-8086-b93c2776486c

	/// Avertissements tolérés.
	measure 'DQ Warnings' = CALCULATE ( COUNTROWS ( '_dq_audit_log' ), '_dq_audit_log'[skipped] = FALSE (), '_dq_audit_log'[passed] = FALSE (), '_dq_audit_log'[severity] = "warning" )
		formatString: #,0
		displayFolder: 08 - Qualité des données
		lineageTag: f22cd614-6317-46f1-9f0c-a928f3bfa658

	/// Somme des lignes en infraction, toutes règles confondues.
	measure 'DQ Failed Rows' = SUM ( '_dq_audit_log'[failures] )
		formatString: #,0
		displayFolder: 08 - Qualité des données
		lineageTag: ff6f13b5-886f-4f9a-8d87-cd020b1f4c9e

	measure 'DQ Last Check' = MAX ( '_dq_audit_log'[checked_at] )
		formatString: dd/mm/yyyy hh:nn
		displayFolder: 08 - Qualité des données
		lineageTag: 72d42635-1666-436d-803c-c126b668a809

	/// Identifiant du dernier run pipeline ayant journalisé des contrôles.
	measure 'DQ Last Run Id' = VAR _last = CALCULATE ( MAX ( '_dq_audit_log'[checked_at] ), REMOVEFILTERS ( '_dq_audit_log' ) ) RETURN CALCULATE ( MAX ( '_dq_audit_log'[pipeline_run_id] ), REMOVEFILTERS ( '_dq_audit_log' ), '_dq_audit_log'[checked_at] = _last )
		displayFolder: 08 - Qualité des données
		lineageTag: 387c7935-e05c-4186-b9c6-9791331f870b

	/// Taux de réussite des contrôles du dernier run.
	measure 'DQ Pass Rate % (last run)' = VAR _id = [DQ Last Run Id] RETURN CALCULATE ( [DQ Pass Rate %], '_dq_audit_log'[pipeline_run_id] = _id )
		formatString: 0.0%
		displayFolder: 08 - Qualité des données
		lineageTag: 5a64296b-524e-4d67-a1f6-757ff25e5126

	measure 'DQ Critical Failures (last run)' = VAR _id = [DQ Last Run Id] RETURN CALCULATE ( [DQ Critical Failures], '_dq_audit_log'[pipeline_run_id] = _id ) + 0
		formatString: #,0
		displayFolder: 08 - Qualité des données
		lineageTag: 950a45b0-9b2b-44e8-8ef4-336733f26f98

	/// Lignes écartées et conservées en quarantaine (aucune perte silencieuse).
	measure 'Quarantined Rows' = COUNTROWS ( '_dq_quarantine' )
		formatString: #,0
		displayFolder: 08 - Qualité des données
		lineageTag: f5050590-28ca-453d-8560-b06892ed8177

	measure 'Avg Generic Gap Label' = VAR _g = [Avg Generic Gap %] RETURN IF ( ISBLANK ( _g ), "–", FORMAT ( _g, "0.0 %" ) )
		displayFolder: 09 - Libellés & navigation
		lineageTag: cfac943b-9e18-49fc-a8d1-dd6f0707a8dc

	/// Signalements débutés, en excluant les dates de début futures (saisies anticipées).
	measure 'Shortages Started (to date)' = CALCULATE ( [Shortage Events], KEEPFILTERS ( gold_dim_time[date_value] <= TODAY () ) )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: 9453752a-2c89-4e7d-b6d5-4eef3ce36b10

	/// Durée maximale active limitée aux 10 spécialités les plus touchées (visuel Top 10).
	measure 'Top10 Active Duration' = VAR _d = [Max Active Duration (days)] VAR _t = ADDCOLUMNS ( ALLSELECTED ( gold_dim_drug[denomination] ), "@d", [Max Active Duration (days)] ) VAR _r = ROWNUMBER ( _t, ORDERBY ( [@d], DESC, gold_dim_drug[denomination], ASC ) ) RETURN IF ( NOT ISBLANK ( _d ) && _r <= 10, _d )
		formatString: #,0 "j"
		displayFolder: 01 - Suivi des ruptures
		lineageTag: c68fceaf-7873-464f-b2c5-49a1e2dae59d

	/// Écart princeps/générique limité aux 10 groupes les plus coûteux.
	measure 'Top10 Generic Gap %' = VAR _g = [Avg Generic Gap %] VAR _t = ADDCOLUMNS ( ALLSELECTED ( gold_kpi_generic_price_gap[libelle_groupe] ), "@g", [Avg Generic Gap %] ) VAR _r = ROWNUMBER ( _t, ORDERBY ( [@g], DESC, gold_kpi_generic_price_gap[libelle_groupe], ASC ) ) RETURN IF ( NOT ISBLANK ( _g ) && _r <= 10, _g )
		formatString: 0.0%
		displayFolder: 04 - Génériques
		lineageTag: 83183c11-06a5-4dbd-b0d5-0a69fbf9fb5d

	/// Présentations comparées entre les deux derniers instantanés de prix.
	measure 'Price Movements' = COUNTROWS ( gold_kpi_price_movement )
		formatString: #,0
		displayFolder: 03 - Prix et remboursement
		lineageTag: 823d74b5-8130-40e1-aad1-46380111df27

	/// Contrôles en échec (critiques + avertissements).
	measure 'DQ Failed Checks' = CALCULATE ( COUNTROWS ( '_dq_audit_log' ), '_dq_audit_log'[skipped] = FALSE (), '_dq_audit_log'[passed] = FALSE () )
		formatString: #,0
		displayFolder: 08 - Qualité des données
		lineageTag: 3d76c0bb-6f45-4c20-9228-cb3161e8192e

	measure 'DQ Failed Rows (failed checks)' = CALCULATE ( SUM ( '_dq_audit_log'[failures] ), '_dq_audit_log'[passed] = FALSE () )
		formatString: #,0
		displayFolder: 08 - Qualité des données
		lineageTag: 9d0cd54a-c926-4a8b-9407-d5953413430b

	/// Part des médicaments en rupture active qui sont d'intérêt thérapeutique majeur.
	measure 'Active Drugs Affected (MITM %)' = DIVIDE ( [MITM Active Drugs Affected], [Active Drugs Affected], BLANK () )
		formatString: 0.0%
		displayFolder: 02 - Score de risque
		lineageTag: 51c03584-bef6-4d14-b8a7-b59678b87030

	/// Signalements débutés sur les 36 derniers mois (hors dates futures) : axe trimestriel lisible.
	measure 'Shortages Started (last 3 years)' = CALCULATE ( [Shortage Events], KEEPFILTERS ( gold_dim_time[date_value] <= TODAY () && gold_dim_time[date_value] > EDATE ( TODAY (), -36 ) ) )
		formatString: #,0
		displayFolder: 01 - Suivi des ruptures
		lineageTag: a5db2923-53eb-4f7a-80b3-fb72787cc08e

	column _Dummy
		dataType: int64
		isHidden
		lineageTag: a1000003-0000-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: [Value]

	partition _Mesures = calculated
		mode: import
		source = { 0 }


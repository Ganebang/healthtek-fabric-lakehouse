	measure 'Active Substance Lines' = CALCULATE ( COUNTROWS ( gold_fact_composition ), gold_fact_composition[is_active_substance] = TRUE () )
		formatString: #,0
		displayFolder: 06 - Substances
		lineageTag: 919cf684-101c-5f65-9451-0a7bf072d2dd

	measure 'Drugs Per Substance' = CALCULATE ( DISTINCTCOUNT ( gold_fact_composition[cis_code] ), gold_fact_composition[is_active_substance] = TRUE () )
		formatString: #,0
		displayFolder: 06 - Substances
		lineageTag: 5ec0de7c-2d12-5ee2-b967-1ab185517e59

	measure 'Distinct Active Substances' = CALCULATE ( DISTINCTCOUNT ( gold_fact_composition[substance_sk] ), gold_fact_composition[is_active_substance] = TRUE () )
		formatString: #,0
		displayFolder: 06 - Substances
		lineageTag: 6c5efc7d-1095-5128-af03-b3b516d48e6b

	measure 'Inferred Drugs' = CALCULATE ( COUNTROWS ( gold_dim_drug ), gold_dim_drug[is_inferred] = TRUE () )
		formatString: #,0
		displayFolder: 07 - Qualité du modèle
		lineageTag: 3617ab3c-cae7-543e-8be9-4d5aa12b03b7

	measure 'Inferred Drugs %' = DIVIDE ( [Inferred Drugs], COUNTROWS ( gold_dim_drug ), BLANK () )

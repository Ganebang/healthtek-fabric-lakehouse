		displayFolder: 04 - Génériques
		lineageTag: cb9677c7-dd81-54d1-8516-b180d5a2eaed

	measure 'Avg Generic Price (EUR)' = AVERAGE ( gold_kpi_generic_price_gap[avg_generic_price] )

	measure 'SMR Insufficient (latest)' = CALCULATE ( DISTINCTCOUNT ( gold_fact_has_opinion[cis_code] ), gold_fact_has_opinion[opinion_type] = "SMR", gold_fact_has_opinion[is_latest_avis] = TRUE (), gold_fact_has_opinion[level_rank] = 1 )
		formatString: #,0

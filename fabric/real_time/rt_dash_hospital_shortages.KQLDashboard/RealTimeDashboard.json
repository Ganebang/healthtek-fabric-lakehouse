      },
      "text": "pharmacy_shortage_events\r\n| where alert_severity == \"CRITICAL\"\r\n| join kind=leftouter (\r\n    gold_dim_drug | project cis_code, denomination, is_mitm, substance_active_primary\r\n) on cis_code\r\n| project event_time, hospital_id, region, cis_code, denomination, is_mitm, substance_active_primary, stock_level\r\n| order by event_time desc",
